<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <!-- Shown until the next setup step (Setup.next) is done -->
        <LinearLayout
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/setupBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/enable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_accent"
                android:gravity="center"
                android:text="Відкрити налаштування"
                android:textColor="#0E0F12"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/appInfo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button"
                android:gravity="center"
                android:text="Інформація про додаток"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The day's time: its own field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/totalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сьогодні"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/totalSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Week: each bar split by app colour; tap a day -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тиждень"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/week"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The day's apps, from the system's activity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/appsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Додатки"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/appList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <Switch
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Віконце поверх додатків"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/nowBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Таймер у Now Bar і рядку стану"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/countReels"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Рахувати Reels і Shorts"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/pick"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Додатки з таймером"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/resetPos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Повернути віконце на місце"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Віконце можна перетягнути пальцем. Усі дані лишаються на телефоні."
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
